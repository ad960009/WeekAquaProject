<Window x:Class="WeekAquaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeekAquaWPF"
        xmlns:vm="clr-namespace:WeekAquaWPF.ViewModels"
        mc:Ignorable="d"
        Title="WeekAqua BLE Controller (C# WPF)" Height="800" Width="1200"
        Background="#18181B" Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
        </Style>

        <!-- Custom Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#52525B"/>
                    <Setter Property="Foreground" Value="#A1A1AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Header & Cell Dark Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateFrame"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateFrame" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"/>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Dark Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#09090B" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#27272A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ WeekAqua BLE Control Center" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0 (C# WPF)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Padding="8,4" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#374151"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#065F46"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340"/>
                <!-- Vertical GridSplitter Bar between Left & Right panels -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Device Scan + Manual Spectrum + Plug Power) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- 1. Top Bluetooth Scanner Card -->
                    <RowDefinition Height="220" MinHeight="140"/>
                    <!-- Horizontal GridSplitter Bar for resizing Bluetooth scanner height -->
                    <RowDefinition Height="8"/>
                    <!-- 2. Bottom Scrollable Control Cards (Live Spectrum, Presets, Timers, Meter) -->
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- 1. BLE Connection Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📶 Bluetooth Device Scanner" FontSize="16" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,8"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="🔍 Scan" Command="{Binding ScanCommand}"/>
                            <Button Grid.Column="1" Content="⚡ Connect" Command="{Binding ConnectCommand}"/>
                            <Button Grid.Column="2" Content="❌ Disconnect" Command="{Binding DisconnectCommand}" Background="#EF4444"/>
                        </Grid>

                        <ListBox Grid.Row="2" ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice}"
                                 IsEnabled="{Binding CanSelectDevice}"
                                 Background="#18181B" BorderBrush="#3F3F46" Foreground="#F4F4F5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ChannelTypeDescription, StringFormat=' ({0})'}" FontSize="11" Foreground="#A78BFA" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="#A1A1AA"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Rssi, StringFormat='{}{0} dBm'}" FontSize="11" Foreground="#34D399" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Horizontal GridSplitter Bar for Left Panel Bluetooth Scanner -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#18181B" ResizeBehavior="PreviousAndNext" Cursor="SizeNS">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#27272A" CornerRadius="4" Margin="0,2">
                                <Rectangle Height="2" Width="40" Fill="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 2. Bottom Scrollable Panel (Manual Spectrum, Presets, Sunrise/Sunset, Energy Meter) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                    <StackPanel>
                        <!-- 2. Live Spectrum Control Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🎨 Live Spectrum Control (FBF9)" FontSize="16" FontWeight="Bold" Foreground="#F472B6"/>
                                    <CheckBox Content="Auto-Send" IsChecked="{Binding AutoSendLiveSpectrum}" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Weighted Total Power Load Meter -->
                                <Border Background="#18181B" CornerRadius="4" Padding="8,4" Margin="0,0,0,8" BorderBrush="#3F3F46" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="⚡ Total Weighted Power Load:" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                            <Run Text="{Binding TotalPowerPercent, Mode=OneWay, StringFormat='{}{0:0.0}%'}" Foreground="#F59E0B"/>
                                            <Run Text="/ 100.0% Max" Foreground="#71717A"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Red Channel -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Red" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RedPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding RedPercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding RedByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Green Channel -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Green" Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GreenPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding GreenPercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding GreenByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Blue Channel -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Blue" Foreground="#3B82F6" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BluePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding BluePercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding BlueByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Channel 4: White / UV (Ultraviolet) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Channel4Name, FallbackValue='White'}" Foreground="{Binding Channel4Color, FallbackValue='#F4F4F5'}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding WhitePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding WhitePercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding WhiteByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Channel 5: UV/UVA / White -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Channel5Name, FallbackValue='UV/UVA'}" Foreground="{Binding Channel5Color, FallbackValue='#8B5CF6'}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding UvPercent, Mode=TwoWay}" IsEnabled="{Binding HasUvChannel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding UvPercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding UvByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Channel 6: Violet/UV2 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Channel6Name, FallbackValue='Violet'}" Foreground="{Binding Channel6Color, FallbackValue='#EC4899'}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VioletPercent, Mode=TwoWay}" IsEnabled="{Binding Has6Channel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding VioletPercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding VioletByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Cooling Fan Speed -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fan" Foreground="#06B6D4" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FanSpeedPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding FanSpeedPercent, Mode=OneWay, StringFormat='{}{0:0}%'}"/>
                                        <Run Text="{Binding FanByte, Mode=OneWay, StringFormat='(0x{0:X2})'}" Foreground="#A1A1AA"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🚀 Send Spectrum" Command="{Binding SendLiveSpectrumCommand}" Margin="0,0,4,0" Background="#EC4899"/>
                                    <Button Grid.Column="1" Content="💨 Send Fan Speed" Command="{Binding SendFanSpeedCommand}" Margin="4,0,0,0" Background="#0891B2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Spectrum Presets Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🌈 App Spectrum Presets (RGBW / Marine)" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                
                                <!-- Freshwater Presets -->
                                <TextBlock Text="🌱 Freshwater (수초/열대어):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🌿 Green" Command="{Binding ApplyPresetCommand}" CommandParameter="Green" Margin="0,0,2,0" Background="#16A34A" Padding="0,4"/>
                                    <Button Grid.Column="1" Content="🍁 Red Plant" Command="{Binding ApplyPresetCommand}" CommandParameter="RedPlant" Margin="2,0,2,0" Background="#DC2626" Padding="0,4"/>
                                    <Button Grid.Column="2" Content="🐠 Mixed" Command="{Binding ApplyPresetCommand}" CommandParameter="Mixed" Margin="2,0,0,0" Background="#D97706" Padding="0,4"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🦐 Shrimp" Command="{Binding ApplyPresetCommand}" CommandParameter="Shrimp" Margin="0,0,2,0" Background="#059669" Padding="0,4"/>
                                    <Button Grid.Column="1" Content="🐟 Fish View" Command="{Binding ApplyPresetCommand}" CommandParameter="Fish" Margin="2,0,2,0" Background="#2563EB" Padding="0,4"/>
                                    <Button Grid.Column="2" Content="💡 Max (100%)" Command="{Binding ApplyPresetCommand}" CommandParameter="Custom" Margin="2,0,0,0" Background="#4F46E5" Padding="0,4"/>
                                </Grid>

                                <!-- Marine / Reef Presets -->
                                <TextBlock Text="🪸 Marine / Reef (해수/산호/6CH):" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🌊 Coral AB+" Command="{Binding ApplyPresetCommand}" CommandParameter="CoralAB" Margin="0,0,2,0" Background="#0284C7" Padding="0,4"/>
                                    <Button Grid.Column="1" Content="🪸 LPS Coral" Command="{Binding ApplyPresetCommand}" CommandParameter="LPSCoral" Margin="2,0,2,0" Background="#7C3AED" Padding="0,4"/>
                                    <Button Grid.Column="2" Content="💎 SPS Coral" Command="{Binding ApplyPresetCommand}" CommandParameter="SPSCoral" Margin="2,0,0,0" Background="#9333EA" Padding="0,4"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🐠 Marine Fish" Command="{Binding ApplyPresetCommand}" CommandParameter="MarineFish" Margin="0,0,2,0" Background="#0D9488" Padding="0,4"/>
                                    <Button Grid.Column="1" Content="🌙 Deep Blue" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepBlue" Margin="2,0,2,0" Background="#1E40AF" Padding="0,4"/>
                                    <Button Grid.Column="2" Content="🌑 Moonlight" Command="{Binding ApplyPresetCommand}" CommandParameter="Moonlight" Margin="2,0,0,0" Background="#312E81" Padding="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Quick Control & Clock Sync Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="⏱️ Clock &amp; Mode Quick Actions" FontSize="16" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="P1 (Green)" Command="{Binding SelectModeCommand}" CommandParameter="1" Margin="0,0,2,0" Background="#16A34A" ToolTip="Preset 1 (Green/Sun)"/>
                                    <Button Grid.Column="1" Content="P2 (Red)" Command="{Binding SelectModeCommand}" CommandParameter="2" Margin="2,0,2,0" Background="#DC2626" ToolTip="Preset 2 (Red Plant)"/>
                                    <Button Grid.Column="2" Content="P3 (Mixed)" Command="{Binding SelectModeCommand}" CommandParameter="3" Margin="2,0,2,0" Background="#D97706" ToolTip="Preset 3 (Mixed)"/>
                                    <Button Grid.Column="3" Content="P4 (Fish)" Command="{Binding SelectModeCommand}" CommandParameter="4" Margin="2,0,0,0" Background="#2563EB" ToolTip="Preset 4 (Fish)"/>
                                </Grid>

                                <Button Content="🕒 Sync PC Clock (RTC 0xFF)" Command="{Binding SyncRtcCommand}" Background="#D97706" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Sunrise & Sunset Timer Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🌅 Sunrise &amp; Sunset Timer (FEF9)" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <TextBlock Text="간편 일출/일몰 모드: 시작/종료 시각과 Ramp 간격을 설정합니다." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Start Time:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBox Grid.Column="1" Text="{Binding SunriseStartStr, UpdateSourceTrigger=PropertyChanged}" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" Padding="6,4" ToolTip="Format: HH:mm (e.g. 08:00)"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="End Time:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBox Grid.Column="1" Text="{Binding SunriseEndStr, UpdateSourceTrigger=PropertyChanged}" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" Padding="6,4" ToolTip="Format: HH:mm (e.g. 18:00)"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ramp Time:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SunriseRampIndex}" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46">
                                        <ComboBoxItem Content="0 Hours (Instant)"/>
                                        <ComboBoxItem Content="0.5 Hours (30 mins)"/>
                                        <ComboBoxItem Content="1.0 Hours (60 mins)"/>
                                        <ComboBoxItem Content="1.5 Hours (90 mins)"/>
                                        <ComboBoxItem Content="2.0 Hours (120 mins)"/>
                                        <ComboBoxItem Content="2.5 Hours (150 mins)"/>
                                    </ComboBox>
                                </Grid>

                                <Button Content="☀️ Set Sunrise &amp; Sunset Timer" Command="{Binding SendSunriseSunsetCommand}" Margin="0,8,0,0" Background="#D97706" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Smart Plug Power Monitor Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="⚡ Smart Plug Energy Meter" FontSize="16" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock Text="Accumulated Power:" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveKwh, StringFormat='{}{0:F2} kWh'}" FontSize="18" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Vertical GridSplitter Bar between Left & Right panels -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#18181B" ResizeBehavior="PreviousAndNext" Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="#27272A" CornerRadius="4" Margin="2,0">
                            <Rectangle Width="2" Height="40" Fill="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right Panel (Ramp Scheduler + Packet Terminal Log) -->
            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="250"/>
                    <!-- Horizontal GridSplitter Bar between Schedule Editor & Packet Log -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- Ramp Schedule Editor Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅 Ramp-up/down Schedule Editor" FontSize="16" FontWeight="Bold" Foreground="#A78BFA"/>
                                <Border Background="#3F3F46" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="연결된 기기 하드웨어 펌웨어에 따라 5슬롯, 8슬롯, 12슬롯으로 자동 분기되어 전송됩니다.">
                                    <TextBlock Text="{Binding ScheduleSlotLimitDescription, FallbackValue='8 Slots (1~8)'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                                <TextBlock Text=" Queue Delay: 500ms" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Content="📡 Sync All Schedule Slots" Command="{Binding SyncAllRampSlotsCommand}" HorizontalAlignment="Right" Background="#7C3AED"/>
                        </Grid>

                        <!-- Schedule Quick Auto-Calculator Helper Card -->
                        <Border Grid.Row="1" Background="#27272A" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="🌅 Sunrise Time:" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding ScheduleSunriseStr, UpdateSourceTrigger=PropertyChanged}" Width="55" FontSize="11" Padding="4,2" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#52525B" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="🌇 Sunset Time:" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding ScheduleSunsetStr, UpdateSourceTrigger=PropertyChanged}" Width="55" FontSize="11" Padding="4,2" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#52525B" TextAlignment="Center"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Content="🌙 Keep Night Moonlight (3~5%)" IsChecked="{Binding KeepMoonlight, Mode=TwoWay}" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="심야/소등 시간대에 완전 암흑 대신 은은한 달빛(Blue 4%)을 유지합니다."/>

                                <Button Grid.Column="4" Content="{Binding AutoScheduleButtonText, FallbackValue='⚡ Auto-Calculate 8-Slot Schedule Times'}" Command="{Binding ApplyAutoScheduleTimesCommand}" Background="#2563EB" FontSize="11" Padding="10,4" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding RampSlots}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Background="#18181B" RowBackground="#27272A"
                                  AlternatingRowBackground="#1F1F23" Foreground="#F4F4F5"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46"
                                  BorderThickness="0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, Mode=TwoWay}" Width="50"/>
                                <DataGridTextColumn Header="Point" Binding="{Binding PointId}" IsReadOnly="True" Width="45"/>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeStr, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" Width="75"/>
                                <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeStr, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" Width="75"/>
                                <DataGridTextColumn Header="Red %" Binding="{Binding RedPercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" Width="55"/>
                                <DataGridTextColumn Header="Green %" Binding="{Binding GreenPercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" Width="55"/>
                                <DataGridTextColumn Header="Blue %" Binding="{Binding BluePercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" Width="55"/>
                                <DataGridTextColumn Binding="{Binding WhitePercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" Width="65">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.ScheduleChannel4Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding UvPercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding IsUvReadOnly}" Width="70">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.ScheduleChannel5Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Violet/UV2 %" Binding="{Binding VioletPercent, Mode=TwoWay, StringFormat='{}{0:0}', ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding IsVioletReadOnly}" Width="75"/>
                                <DataGridTextColumn Header="Total Power" Binding="{Binding TotalPowerPercent, Mode=OneWay, StringFormat='{}{0:0.0}%'}" IsReadOnly="True" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Horizontal GridSplitter Bar between Schedule Editor & Packet Log -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#18181B" ResizeBehavior="PreviousAndNext" Cursor="SizeNS">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#27272A" CornerRadius="4" Margin="0,2">
                                <Rectangle Height="2" Width="40" Fill="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- BLE Packet Terminal Log Card -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="🖥️ Raw BLE Packet Log" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Button Content="Clear" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right" Background="#475569" Padding="8,2"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="#09090B" BorderBrush="#27272A" Foreground="#F4F4F5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Padding="4,1" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DirectionString}" Value="TX">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DirectionString}" Value="RX">
                                                            <Setter Property="Background" Value="#8B5CF6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DirectionString}" Value="Error">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DirectionString}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding HexData}" FontFamily="Consolas" FontSize="12" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
